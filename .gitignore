# Visual baselines are generated + committed for Linux/CI only; never commit a dev box's own
# (darwin/win) baselines or Playwright's transient actual/diff captures.
mobile/android/dashboard-e2e/**/*-darwin.png
mobile/android/dashboard-e2e/**/*-win32.png
mobile/android/dashboard-e2e/**/*-actual.png
mobile/android/dashboard-e2e/**/*-diff.png

# Logs
logs/
*.log

# Local Codex/agent scratch reports — keep on disk, out of the repo
.codex-ui-validation/
.Codex/
dogfood-output/
mobile/android/dogfood-output/

# Backups
backups/

# Android OBD debug artifacts (large on-phone DB pulls, route-extraction scratch)
mobile/android/docs/db-pulls/

# Dashboard Vitest coverage output (D4)
mobile/android/dashboard-tests/coverage/

