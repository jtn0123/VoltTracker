{
  "name": "volttracker-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.7",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "flatpickr": "^4.6.13",
    "leaflet": "^1.9.4",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6"
  }
}
