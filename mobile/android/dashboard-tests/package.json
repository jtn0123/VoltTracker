{
  "name": "volttracker-dashboard-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/vitest-results.json",
    "setup": "npm ci",
    "lint": "cd .. && eslint \"app/src/main/dashboard-src/js/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "leaflet": "1.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
