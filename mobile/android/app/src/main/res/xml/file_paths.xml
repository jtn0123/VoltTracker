<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Backup files are written here before being handed to the share sheet. -->
    <cache-path name="backups" path="backups/" />
    <!-- DiagnosticsShareIntent zips session logs + rolling app log here. -->
    <cache-path name="diagnostics" path="diagnostics/" />
    <!-- TripExportShareIntent writes per-trip GPX/CSV exports here before the share sheet. -->
    <cache-path name="trip-exports" path="trip-exports/" />
</paths>
