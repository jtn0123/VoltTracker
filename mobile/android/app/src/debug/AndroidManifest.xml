<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same values as the main manifest (the merged result is unchanged); repeated here so the
         debug overlay is safe on its own. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- Debug-only launch handle for the CI emulator smoke: the harness must
             shell-start the classic WebView dashboard to assert its JS handshake,
             but MainActivity is not exported and API 34 rejects both plain shell
             `am start` and `run-as` for non-exported activities. The alias exists
             only in debug builds. -->
        <activity-alias
            android:name=".DebugClassicDashboard"
            android:exported="true"
            android:targetActivity=".MainActivity" />
        <!-- Debug-only stable launch handle for the native Compose dashboard (the launcher):
             `adb shell am start -n <pkg>/.DebugComposeDashboard` for previews and screen
             recordings. Absent from release builds. -->
        <activity-alias
            android:name=".DebugComposeDashboard"
            android:exported="true"
            android:targetActivity=".ComposeDashboardActivity" />
    </application>
</manifest>
