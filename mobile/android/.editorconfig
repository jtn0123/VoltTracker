root = true

# Editor hints mirror Spotless/ktlint/prettier. Run ./gradlew :app:spotlessApply
# when your editor disagrees with CI.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,java}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.kt]
# @Composable functions are conventionally PascalCase; keep ktlint's function-naming
# rule from flagging every Compose screen/component.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{ts,js,css,html,json,yml,yaml,md}]
indent_style = space
indent_size = 2
